{
  "$defs": {
    "PromptBlock": {
      "description": "快照里一段内容的语义块。由**编译器在装配时标注**，不是事后猜的。\n\n``key`` 是闭集：新车道没写进映射表时落到 ``other``，不会静默算进别的组。",
      "enum": [
        "system",
        "persona",
        "memory",
        "plan",
        "media",
        "summary",
        "history",
        "input",
        "other"
      ],
      "title": "PromptBlock",
      "type": "string"
    },
    "PromptSnapshotItem": {
      "additionalProperties": false,
      "description": "快照里的一条消息。``index`` 是它在**真实 messages 数组**里的下标。\n\n截断后下标会跳号——这是**故意的**：跳号说明中间被丢掉了，\n而不是\"她当时只看到这些\"。",
      "properties": {
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "lane": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lane"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "v1",
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sender"
        },
        "tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "role",
        "content"
      ],
      "title": "PromptSnapshotItem",
      "type": "object"
    }
  },
  "$id": "https://ling.local/contracts/v1/PromptSnapshotSection.schema.json",
  "additionalProperties": false,
  "description": "一个语义块的展示分组。``label`` 直接给前端显示，**不要在前端再翻译**。",
  "properties": {
    "collapsed": {
      "default": false,
      "title": "Collapsed",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/PromptSnapshotItem"
      },
      "title": "Items",
      "type": "array"
    },
    "key": {
      "$ref": "#/$defs/PromptBlock"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "role": {
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Tokens",
      "type": "integer"
    }
  },
  "required": [
    "key",
    "label",
    "role"
  ],
  "title": "PromptSnapshotSection",
  "type": "object",
  "x-ling-schema-version": "v1"
}
