      "title": "ImageUpdateUpdaterDetails",
      "type": "object"
    }
  },
  "$id": "https://ling.local/contracts/v1/ImageUpdateView.schema.json",
  "additionalProperties": true,
  "description": "``GET /v1/version/image-update``：四态卡片 + 诊断。\n\n``message`` 是服务端算好的一句话人话（不含原因码/摘要/路径），前端直接显示。\n活动任务进行中时它讲进度（「更新正在进行中…」），``state`` 仍是发现结论。\n\n下半部分是**旧字段**：保留一个版本给尚未迁移的调用方，新代码不要读。",
  "properties": {
    "available_targets": {
      "deprecated": true,
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Available Targets",
      "type": "array"
    },
    "backup_gate": {
      "additionalProperties": true,
      "deprecated": true,
      "title": "Backup Gate",
      "type": "object"
    },
    "catalog": {
      "additionalProperties": true,
      "deprecated": true,
      "title": "Catalog",
      "type": "object"
    },
    "checked_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked At"
    },
    "current": {
      "$ref": "#/$defs/ImageUpdateCurrent"
    },
    "details": {
      "$ref": "#/$defs/ImageUpdateDetails"
    },
    "enabled": {
      "deprecated": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "image_mode": {
      "deprecated": true,
      "title": "Image Mode",
      "type": "boolean"
    },
    "installable": {
      "deprecated": true,
      "title": "Installable",
      "type": "boolean"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "newer": {
      "items": {
        "$ref": "#/$defs/ImageNewerRelease"
      },
      "title": "Newer",
      "type": "array"
    },
    "next_actions": {
      "deprecated": true,
      "items": {
        "type": "string"
      },
      "title": "Next Actions",
      "type": "array"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "deprecated": true,
      "title": "Reason"
    },
    "reason_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "deprecated": true,
      "title": "Reason Message"
    },
    "request": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "deprecated": true,
      "title": "Request"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ImageUpdateState"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImageUpdateTarget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImageUpdateTaskRow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "updater": {
      "additionalProperties": true,
      "deprecated": true,
      "title": "Updater",
      "type": "object"
