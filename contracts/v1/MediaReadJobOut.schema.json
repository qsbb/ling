        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "$ref": "#/$defs/MediaReadJobState"
    },
    "window_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Window Id",
      "type": "string"
    }
  },
  "required": [
