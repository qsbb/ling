{
  "$defs": {
    "ImageReleaseCheckCurrent": {
      "additionalProperties": true,
      "description": "更新器实测的**当前运行版本**（读运行中 api 镜像的 OCI ``version`` 标注）。",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "title": "ImageReleaseCheckCurrent",
      "type": "object"
    },
    "ImageReleaseCheckLatest": {
      "additionalProperties": true,
      "description": "本次检查发现的最高稳定版（registry ``tags/list`` + manifest 解析结果）。",
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "title": "ImageReleaseCheckLatest",
      "type": "object"
    }
  },
  "$id": "https://ling.local/contracts/v1/ImageReleaseCheckDetails.schema.json",
  "additionalProperties": true,
  "description": "更新器 ``status.json`` 顶层 ``release_check`` 的白名单投影。\n\n这是「有没有新版本」的**唯一**事实源（设计\ndocs/UPDATE-SIMPLIFICATION-DESIGN.md §3）。``reason_detail`` 只投影固定枚举\n``null | \"throttled\"``——更新器那个字段只有这两个值，别的值（自由文本，可能带\nregistry URL、凭据片段或原始异常）一律丢弃。",
  "properties": {
    "check_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Check Id"
    },
    "checked_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked At"
    },
    "current": {
      "$ref": "#/$defs/ImageReleaseCheckCurrent"
    },
    "latest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImageReleaseCheckLatest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "reason_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Detail"
    },
    "reason_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Message"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State"
    },
    "tag_count": {
      "default": 0,
      "minimum": 0,
      "title": "Tag Count",
      "type": "integer"
    }
  },
  "title": "ImageReleaseCheckDetails",
  "type": "object",
  "x-ling-schema-version": "v1"
}
