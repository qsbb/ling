{
  "$defs": {
    "DeliveryState": {
      "enum": [
        "queued",
        "sent",
        "delivered",
        "failed",
        "uncertain",
        "unsupported"
      ],
      "title": "DeliveryState",
      "type": "string"
    }
  },
  "$id": "https://ling.local/contracts/v1/DeliveryReceipt.schema.json",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Channel",
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "platform_message_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform Message Id"
    },
    "receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": "v1",
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/DeliveryState"
    }
  },
  "required": [
    "receipt_id",
    "operation_id",
    "channel",
    "state",
    "observed_at"
  ],
  "title": "DeliveryReceipt",
  "type": "object",
  "x-ling-schema-version": "v1"
}
