# ling API 镜像（amd64/arm64，纯 CPU 即可运行）
#
# 多阶段：先装依赖到 venv，再复制到精简运行时；非 root 运行。

# 基础镜像可由构建参数覆盖：离线/内网环境常需使用本地已有镜像仓库
# 例：docker compose build --build-arg LING_PYTHON_BASE=python:3.12-slim
ARG LING_PYTHON_BASE=python:3.13-slim

FROM ${LING_PYTHON_BASE} AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=0

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
# **必须拷**：pyproject 里声明的 wheel 包含 `connectors`（渠道连接器）。
# 少这一行的话构建会因为找不到包而打不出完整 wheel——或者在能容忍缺失时
# 静默产出一个没有 connectors 的镜像，表现为容器里 QQ/NapCat 全部连不上，
# 日志只说"缺少凭据"或干脆没有日志。dev 里正常、容器里死掉，就是这种坑。
COPY connectors ./connectors
# PyPI 在部分网络环境下**超时频繁**（实测 NAS 上 `ReadTimeoutError`
# 导致整次部署失败）。这里加两个东西：
#   1. `--retries/--timeout`：给慢网络留余地，而不是一次超时就放弃
#   2. `PIP_INDEX_URL`：允许换镜像源（国内可用清华源），默认仍是官方 PyPI
ARG PIP_INDEX_URL=""
RUN pip install --no-cache-dir --retries 5 --timeout 60 \
      ${PIP_INDEX_URL:+--index-url ${PIP_INDEX_URL}} build \
 && pip wheel --no-cache-dir --retries 5 --timeout 60 \
      ${PIP_INDEX_URL:+--index-url ${PIP_INDEX_URL}} --wheel-dir /wheels . \
 && ls /wheels


FROM ${LING_PYTHON_BASE} AS runtime

# 构建提交标记：由 install.sh 在构建前解析（本检出 git HEAD 的 40 位 sha），
# 或由宿主更新执行器按 release 的确切提交导出。没有就是空串——运行时
# /v1/version 报 commit=null，而不是把未知提交伪装成真实提交。
# 只在 runtime 阶段声明：builder 阶段不需要，也不该影响 wheel 内容。
ARG LING_COMMIT=""
ENV LING_COMMIT=${LING_COMMIT}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    # 让迁移器稳定定位 alembic.ini 与 migrations/（镜像内为 /app）
    LING_PROJECT_ROOT=/app

RUN groupadd --system --gid 10001 ling \
 && useradd --system --uid 10001 --gid ling --home-dir /app --shell /usr/sbin/nologin ling \
 && mkdir -p /app /data /app/web \
 && chown -R ling:ling /app /data

WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/*.whl && rm -rf /wheels

COPY --chown=ling:ling src ./src
# 同上：入口脚本与部分运行期代码会 `import connectors.*`，镜像里必须有。
COPY --chown=ling:ling connectors ./connectors
COPY --chown=ling:ling alembic.ini ./alembic.ini
COPY --chown=ling:ling migrations ./migrations
COPY --chown=ling:ling deploy/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER ling
# 容器内固定监听 6520（entrypoint 的 uvicorn / compose 的 expose 与 healthcheck
# 都是这个值）。EXPOSE 只是元数据，不影响监听，但写错会让人以为容器在 8080。
EXPOSE 6520
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["api"]
