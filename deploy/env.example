# ling 部署环境（复制为 deploy/.env 后按需修改；不要把真实密钥提交进仓库）

# --- 数据库 ---
POSTGRES_PASSWORD=change-me-postgres-password

# --- 引导管理员（首次启动创建；之后请在控制台管理） ---
LING_BOOTSTRAP_ADMIN=ling
LING_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# --- 根加密密钥：加密供应商密钥。生产必须固定，不要每次重新生成 ---
# 生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LING_ROOT_KEY=

# --- 模式 ---
# 0 = 只用真实模型（未配置模型时对话会明确失败）
# 1 = 允许 fake provider（仅用于测试，UI 会显示"测试模式"）
LING_TEST_MODE=0

# --- 端口与 Cookie ---
# api 容器内固定监听 6520（compose 的 expose 与 healthcheck 都是这个值）。
# **不再有 nginx 反代**：api 自己发布宿主端口，就是下面的 LING_PORT。
# install.sh 的就绪等待、安装摘要与 --status 都以 `docker compose config` 解析出的
# api 发布端口为准（不再假定 18080）：已有这份 .env 时改端口请改这里，不要用
# --port 去覆盖（安装器不写已有 .env；--port 与真实端口冲突时会直接失败，
# 而不是对着错端口等 120 秒）。
# 走 HTTPS 反代（自己前置 Caddy/nginx）时设 1
LING_COOKIE_SECURE=0

# --- 前端构建产物所在目录 ---
# 相对 deploy/ 解析。**不要写死某个 release 树的绝对路径**：这份 .env 可能被
# 多个 release 共用（symlink），绝对值会让后续手动安装挂到旧前端并 fail-closed。
# 手动升级另一棵树时，在那次 shell 里显式 export 那棵树已验证的 dist。
LING_WEB_DIST_HOST=../clients/web-console/dist

# --- 镜像来源（离线/内网环境用本地已有镜像）---
# 这里的值（以及 shell 里的同名变量）都是**显式选择**：install.sh 原样保留，
# 不会因为拉不到就换成别的版本。只有“没显式配置”的默认镜像在官方名不可用
# 时才换成**同一 tag** 的镜像源（示例里 postgres:16 不会退成 18）；两处都拿
# 不到就 fail closed。安装器只把结果导出到本次进程环境，**不写回本文件**。
# LING_PYTHON_BASE=python:3.12-slim
# LING_POSTGRES_IMAGE=postgres:17-alpine
LING_PYTHON_BASE=python:3.13-slim
LING_POSTGRES_IMAGE=postgres:16-alpine
# 构建期 PyPI 源（可选）。留空 = 官方源；install.sh 探测 pypi.org 失败时只会把
# 镜像源导出到本次进程环境，不写回本文件。显式填了就原样使用（不回显）。
PIP_INDEX_URL=

# --- 多副本与入口 ---
# api 副本数。多副本依赖 PostgreSQL 中的跨实例协调（停止信号 + 发言租约），
# 不在进程内存里保存权威状态。流式续传与群发言频率仍是单实例语义。
# **默认 1，不要随手改成 2**：api 现在自己发布固定宿主端口（LING_PORT），
# 而 compose 非 swarm 模式下 `ports` 只能给一个容器 —— 2 个副本会直接端口
# 冲突，第二个容器起不来。确实需要多副本时，请自己前置一个反代
# （deploy/nginx.conf / nginx-tls.conf 保留给这种用法，但它们不再是 compose
# 服务），并把这里的副本数调上去。
LING_API_REPLICAS=1
# api 的宿主发布端口（容器内固定 6520，这个值只改宿主侧）。
# 安装器按 compose 解析结果等待 /readyz 与打印摘要，不用脚本里写死的默认端口。
LING_PORT=6520

# worker 副本数（多副本依赖 handler 幂等：唯一约束见 migration 0008/0009）
LING_WORKER_REPLICAS=1

# --- 请求体上限 ---
# 单个请求体最大字节数，默认 33554432（32MiB）——等于原 nginx 的
# `client_max_body_size 32m`。删掉反代后这条限制由应用自己执行：超限请求在
# 读 body 之前就被拒（413，带 trace_id），不会把进程内存吃光。
# 留空 = 用默认值。上传大文件被 413 挡住时改这里（单位是**字节**，不是 MB）。
LING_MAX_BODY_BYTES=

# --- OneBot V11（NapCat / Lagrange / go-cqhttp）---
# OneBot 实现的 HTTP API 地址（对应其 http.host / http.port）
LING_ONEBOT_API_BASE=http://127.0.0.1:5700
# OneBot 侧配了 access_token 时必须一致，否则 401/403
LING_ONEBOT_ACCESS_TOKEN=
# 反向上报签名密钥；配了就必须校验 HMAC-SHA1
LING_ONEBOT_SECRET=
# 机器人自己的 QQ 号，用于校验 X-Self-ID
LING_ONEBOT_SELF_ID=
# 实例标识，进入账号绑定命名空间（多开时区分）
LING_ONEBOT_INSTANCE_ID=onebot-default
LING_ONEBOT_SUPPORTS_GROUP=1
# 主动推送取决于实现与账号权限，默认关闭，探测通过再打开
LING_ONEBOT_PROACTIVE=0

# --- 语义检索（可选；不配则退回 BM25+RRF 字面路径）---
# Cloudflare Workers AI 向量化（BGE-M3，1024 维，多语言）
LING_EMBEDDING_API_BASE=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
LING_EMBEDDING_ACCOUNT_ID=
LING_EMBEDDING_API_KEY=
LING_EMBEDDING_MODEL=@cf/baai/bge-m3
# SiliconFlow 重排（BGE reranker v2 m3）
LING_RERANK_API_BASE=https://api.siliconflow.cn/v1
LING_RERANK_API_KEY=
LING_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 访问边界（TLS）---
# **Ling 默认不再使用 edge/nginx 反代**：api 直接监听 LING_PORT，没有内置 TLS。
# deploy/nginx.conf 与 deploy/nginx-tls.conf 仍然保留，但只是**示例配置**：
# 需要 HTTPS 或公网暴露的用户，自己起一个 Caddy/nginx 容器反代到 api 的
# 6520（示例见 nginx-tls.conf 顶部注释），证书也由那层自己管。
# 上 TLS 后必须同时打开 cookie Secure，否则凭证仍可能走明文。
# 这里**不再重复定义** LING_COOKIE_SECURE：它已在上方“端口与 Cookie”定义一次，
# 同一个文件里写两处会出现“改了一处、另一处仍是旧值”的歧义。
# 启用 TLS 时请把上面那个 LING_COOKIE_SECURE 改成 1。

# --- 备份新鲜度（可选）---
# 备份目录（宿主绝对路径）。/v1/health/ops 用它判断“超过 48 小时没有新备份”。
# 容器部署默认**看不到**宿主备份目录（compose 不挂载它）：要让这项检查生效，
# 需在宿主 override 里把该目录只读挂进 api，并把这里设成**容器内路径**。
# 与 deploy/backup/backup.sh 的输出目录保持同一个来源。
LING_BACKUP_DIR=

# --- 告警推送（可选）---
# 通用 webhook：POST JSON，任意能接收 HTTP 的服务都行
# （Telegram Bot API、Discord、钉钉/飞书机器人、ntfy、自建脚本）。
# 留空则只在 worker 日志里记录告警，不主动推送。
LING_ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------- QQ 官方机器人
# 走 WebSocket 网关：ling 主动连出去，不需要公网回调地址、不需要扫码。
# 凭据在 q.qq.com → 机器人 → 开发设置（AppID / AppSecret）。
LING_QQBOT_ENABLED=0
LING_QQBOT_APP_ID=
LING_QQBOT_CLIENT_SECRET=
LING_QQBOT_INSTANCE_ID=qqbot-default
# 沙箱=1 时只能和沙箱名单里的测试账号对话；正式环境设 0
LING_QQBOT_SANDBOX=1
# 主动推送要平台单独开通，没开通就保持 0
LING_QQBOT_PROACTIVE=0
LING_QQBOT_SUPPORTS_GROUP=1

# ---------------------------------------------------------------- 出入许可
# 谁能跟她说话。qqbot 的发送者是 openid（不是 QQ 号），NapCat 那边才是 QQ 号。
LING_ACCESS_MODE=whitelist
LING_ACCESS_LIST=

# 勿扰时段与每日限额按这个时区算。不填会退回 UTC。
LING_USER_TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------- 构建提交标记
# install.sh 构建前会自动填入本检出 git HEAD（或宿主执行器导出的 LING_COMMIT），
# 手工 `docker compose build` 时留空即可：/v1/version 会报 commit=null，不伪造。
LING_COMMIT=

# ---------------------------------------------------------------- 自助更新（默认关闭）
# 只有“已经由宿主人工纳管”的部署才该打开。install.sh **不会**自动启用，
# 本文件也保持 0；打开前请先在宿主机完成更新执行器初始化：
#   1) 由宿主 init 创建 requests 目录并把写权限赋给容器里的 uid 10001；
#      status 目录只允许宿主写，**不要 chmod 0777**（会变成任何人都能伪造状态）。
#   2) 确认数据库与 deploy/.env 的备份/人工恢复步骤（真实 Docker 演练尚未完成）。
#   3) 先只读检查 status/日志，确认执行器识别的是本 release 的 tag/commit。
# 关闭时 api 不读这两个目录，也不会出现任何“可自动更新”的入口。
LING_UPDATE_ENABLED=0
# 宿主机目录（Compose 的 bind mount 源，相对路径以 deploy/ 为基准）。
# api 只写 requests、只读 status；worker 不挂这两个目录。
# 容器内路径固定为 /run/ling-update/requests 与 /run/ling-update/status，
# 由 compose 注入，不要试图用 .env 覆盖——那样执行器和 api 会看不同的目录。
# 真实部署请**显式**写成宿主绝对路径，并和执行器配置里的 requests_dir /
# status_dir 完全一致（示例：/run/ling-update/requests 与 /run/ling-update/status；
# 执行器 init 会创建目录并把 requests 赋权给 uid 10001，status 只允许宿主写）。
# 下面两个相对默认值只适合在仓库目录里做本机试验，不是生产推荐值。
LING_UPDATE_REQUESTS_HOST=../.run/update/requests
LING_UPDATE_STATUS_HOST=../.run/update/status

# ---------------------------------------------------------------- 安装器专属（别写在这里）
# 下面这些是 install.sh / 宿主更新执行器读的**进程环境变量**，不是 Compose 变量。
# 写进这个 .env 不会生效（安装器不自己解析 .env 里的“安装器开关”），列在这里只为
# 避免有人写错地方后排查半天：
#   LING_INSTALL_PHASE_FILE        安装阶段标记（可信绝对路径；执行器传）
#   LING_INSTALL_LOCK_FD          宿主持锁后传给安装器的锁 FD（**不要手工设置**）
#   LING_INSTALL_COMPOSE_OVERRIDE  宿主生成的 Compose override 绝对路径。
#       install.sh 只把 `-f <该路径>` 追加在 `-f deploy/compose.yaml` 之后（始终
#       保留 --env-file deploy/.env），不复制、不改写、不直接解析其文本（解析交给
#       Compose；文件可以是 JSON，即 YAML 的子集）；用于跨独立 release 固定 bind
#       来源。它必须已存在且是普通文件（绝对路径、拒绝 symlink/目录/FIFO、≤1 MiB），
#       否则安装器直接失败；解析结果不能搬走 /app/web 或持久数据卷。
#       **信任边界**：override 是宿主信任输入。安装器只保证上面两个结构不变量，
#       **没有安全 allowlist**：它能新增 privileged/cap_add/user/network_mode、
#       docker.sock 之类的 bind、镜像或 command 覆盖。不要从 Web、半可信脚本或
#       可被普通用户改写的路径生成它；请由 root/部署用户持有（0600），并只写
#       你核实过的字段。
# 另外：宿主的 HOME / DOCKER_CONFIG 会被原样保留（docker context / registry 凭据
# 跟着它们走）；只有 HOME 缺失或不可写时才回退到仓库内已忽略的 .run/home 与
# .run/docker 并告警（旧版的 .home/.docker 不再使用，也不会被删除/搬移）。
