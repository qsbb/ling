# ling 部署环境（复制为 deploy/.env 后按需修改；不要把真实密钥提交进仓库）

# --- 数据库 ---
POSTGRES_PASSWORD=change-me-postgres-password

# --- 引导管理员（首次启动创建；之后请在控制台管理） ---
LING_BOOTSTRAP_ADMIN=ling
LING_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# --- 根加密密钥：加密供应商密钥。生产必须固定，不要每次重新生成 ---
# 生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LING_ROOT_KEY=

# --- 模式 ---
# 0 = 只用真实模型（未配置模型时对话会明确失败）
# 1 = 允许 fake provider（仅用于测试，UI 会显示"测试模式"）
LING_TEST_MODE=0

# --- 端口与 Cookie ---
LING_API_PORT=8080
# 走 HTTPS 反代时设 1
LING_COOKIE_SECURE=0

# --- 前端构建产物所在目录（宿主机路径）---
LING_WEB_DIST_HOST=../clients/web-console/dist

# --- 镜像来源（离线/内网环境用本地已有镜像）---
# 本机无外网或镜像仓库需鉴权时，指向本地已有镜像：
# LING_PYTHON_BASE=python:3.12-slim
# LING_POSTGRES_IMAGE=postgres:18-alpine
LING_PYTHON_BASE=python:3.13-slim
LING_POSTGRES_IMAGE=postgres:16-alpine

# --- 多副本与入口 ---
# api 副本数。多副本依赖 PostgreSQL 中的跨实例协调（停止信号 + 发言租约），
# 不在进程内存里保存权威状态。流式续传与群发言频率仍是单实例语义。
LING_API_REPLICAS=2
# 对外只暴露 edge（nginx）；api 副本不发布 host 端口
LING_EDGE_PORT=8080
LING_NGINX_IMAGE=nginx:alpine

# worker 副本数（多副本依赖 handler 幂等：唯一约束见 migration 0008/0009）
LING_WORKER_REPLICAS=1

# --- OneBot V11（NapCat / Lagrange / go-cqhttp）---
# OneBot 实现的 HTTP API 地址（对应其 http.host / http.port）
LING_ONEBOT_API_BASE=http://127.0.0.1:5700
# OneBot 侧配了 access_token 时必须一致，否则 401/403
LING_ONEBOT_ACCESS_TOKEN=
# 反向上报签名密钥；配了就必须校验 HMAC-SHA1
LING_ONEBOT_SECRET=
# 机器人自己的 QQ 号，用于校验 X-Self-ID
LING_ONEBOT_SELF_ID=
# 实例标识，进入账号绑定命名空间（多开时区分）
LING_ONEBOT_INSTANCE_ID=onebot-default
LING_ONEBOT_SUPPORTS_GROUP=1
# 主动推送取决于实现与账号权限，默认关闭，探测通过再打开
LING_ONEBOT_PROACTIVE=0

# --- 语义检索（可选；不配则退回 BM25+RRF 字面路径）---
# Cloudflare Workers AI 向量化（BGE-M3，1024 维，多语言）
LING_EMBEDDING_API_BASE=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
LING_EMBEDDING_ACCOUNT_ID=
LING_EMBEDDING_API_KEY=
LING_EMBEDDING_MODEL=@cf/baai/bge-m3
# SiliconFlow 重排（BGE reranker v2 m3）
LING_RERANK_API_BASE=https://api.siliconflow.cn/v1
LING_RERANK_API_KEY=
LING_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 访问边界（TLS）---
# 只在本机/可信 VPN 访问时用默认明文配置即可。
# 走公网时：LING_EDGE_CONF=./nginx-tls.conf，并把证书放进 LING_EDGE_CERTS。
LING_EDGE_CONF=./nginx.conf
LING_EDGE_CERTS=./certs
LING_EDGE_TLS_PORT=8443
# 上 TLS 后必须同时打开 cookie Secure，否则凭证仍可能走明文
LING_COOKIE_SECURE=0

# --- 告警推送（可选）---
# 通用 webhook：POST JSON，任意能接收 HTTP 的服务都行
# （Telegram Bot API、Discord、钉钉/飞书机器人、ntfy、自建脚本）。
# 留空则只在 worker 日志里记录告警，不主动推送。
LING_ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------- QQ 官方机器人
# 走 WebSocket 网关：ling 主动连出去，不需要公网回调地址、不需要扫码。
# 凭据在 q.qq.com → 机器人 → 开发设置（AppID / AppSecret）。
LING_QQBOT_ENABLED=0
LING_QQBOT_APP_ID=
LING_QQBOT_CLIENT_SECRET=
LING_QQBOT_INSTANCE_ID=qqbot-default
# 沙箱=1 时只能和沙箱名单里的测试账号对话；正式环境设 0
LING_QQBOT_SANDBOX=1
# 主动推送要平台单独开通，没开通就保持 0
LING_QQBOT_PROACTIVE=0
LING_QQBOT_SUPPORTS_GROUP=1

# ---------------------------------------------------------------- 出入许可
# 谁能跟她说话。qqbot 的发送者是 openid（不是 QQ 号），NapCat 那边才是 QQ 号。
LING_ACCESS_MODE=whitelist
LING_ACCESS_LIST=

# 勿扰时段与每日限额按这个时区算。不填会退回 UTC。
LING_USER_TIMEZONE=Asia/Shanghai
